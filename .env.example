# 公開URL。OGP・canonical・sitemap の絶対URLに使われます。
# 未設定の場合は https://cocodesign.pro が使われます。
NEXT_PUBLIC_SITE_URL=https://cocodesign.pro

# サブディレクトリで公開する場合のみ設定します（例: GitHub Pages のプロジェクトページ）。
# Cloudflare Pages や独自ドメインのようにルート直下で公開するなら未設定のままにします。
# NEXT_PUBLIC_BASE_PATH=/cocodesign-qr

# 本実装のQR変換APIのベースURL。
# 設定すると、画面はそのままでブラウザ内処理からサーバーAPIへ切り替わります
# （src/lib/convert/index.ts）。一括変換・登録・PDF入力を実装するときに使います。
# NEXT_PUBLIC_CONVERT_API_BASE=https://api.cocodesign.pro
