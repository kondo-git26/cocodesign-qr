# 公開URL。OGP・canonical・sitemap の絶対URLに使われます。
# 未設定の場合は https://cocodesign-qr.netlify.app が使われます。
NEXT_PUBLIC_SITE_URL=https://cocodesign-qr.netlify.app

# 本実装のQR変換APIのベースURL。
# 設定するとフロントエンドはモックではなく実APIを呼びます（src/lib/convert/index.ts）。
# 未設定のあいだはブラウザ内のモックで動作します。
# NEXT_PUBLIC_CONVERT_API_BASE=https://api.example.com/qr
